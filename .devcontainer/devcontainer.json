{
  "name": "Python with uv",
  "image": "ghcr.io/astral-sh/uv:python3.11-bookworm",
  
  "postCreateCommand": "uv pip install --system -r requirements.txt",
  
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}